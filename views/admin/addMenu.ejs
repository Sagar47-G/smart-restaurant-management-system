<h1>Add Menu Item</h1>

<form action="/admin/add-menu" method="POST">

    <input
        type="text"
        name="name"
        placeholder="Item Name"
        required
    >

    <input
        type="number"
        name="price"
        placeholder="Price"
        required
    >

    <button type="submit">
        Add Item
    </button>

</form>