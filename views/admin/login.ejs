<!DOCTYPE html>
<html>
<head>
    <title>Admin Login</title>
    <style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Segoe UI',sans-serif;
}

body{
    background:linear-gradient(135deg,#ff6b35,#ff9f43);
    height:100vh;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
}

form{
    background:white;
    padding:35px;
    border-radius:20px;
    box-shadow:0 8px 25px rgba(0,0,0,0.2);
    width:350px;
}

h1{
    text-align:center;
    color:#000000;
    margin-bottom:25px;
}

input{
    width:100%;
    padding:12px;
    border:2px solid #eee;
    border-radius:10px;
    font-size:16px;
    transition:0.3s;
}

input:focus{
    outline:none;
    border-color:#ff6b35;
}

button{
    width:100%;
    padding:12px;
    border:none;
    border-radius:10px;
    background:#ff6b35;
    color:white;
    font-size:16px;
    font-weight:bold;
    cursor:pointer;
    transition:0.3s;
}

button:hover{
    background:#e85a2a;
    transform:translateY(-2px);
}

.login-card{
    background:white;
    padding:40px;
    border-radius:20px;
    box-shadow:0 8px 25px rgba(0,0,0,0.2);
}
</style>
</head>
<body>

<h1>Admin Login</h1>

<form action="/admin/login" method="POST">

    <input type="text"
           name="username"
           placeholder="Username"
           required>

    <br><br>

    <input type="password"
           name="password"
           placeholder="Password"
           required>

    <br><br>

    <button type="submit">
        Login
    </button>

</form>

</body>
</html>