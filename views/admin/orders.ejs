<!DOCTYPE html>
<html>
<head>
    <title>All Orders</title>

    <style>
        .table-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:20px;
}

.table-card{
    background:white;
    padding:20px;
    border-radius:10px;
    box-shadow:0 2px 5px rgba(0,0,0,0.2);
    text-align:center;
}
    </style>
</head>
<body>
<h1>Restaurant Tables</h1>

<div class="table-grid">

<% orders.forEach(order => { %>

    <div class="table-card">
        <h2>Table <%= order.tableNo %></h2>

        <p>
            <strong>Items:</strong><br>
            <%= order.items.map(item => item.name).join(", ") %>
        </p>

        <p>
            <strong>Total:</strong>
            ₹<%= order.totalAmount %>
        </p>

        <p>
            <strong>Status:</strong>
            <%= order.status %>
        </p>

        <a class="btn preparing"
           href="/admin/order/<%= order._id %>/Preparing">
           Preparing
        </a>

        <a class="btn ready"
           href="/admin/order/<%= order._id %>/Ready">
           Ready
        </a>

        <a class="btn served"
           href="/admin/order/<%= order._id %>/Served">
           Served
        </a>

    </div>

<% }) %>

</div>

</body>
</html>