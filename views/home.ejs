<!DOCTYPE html>
<html>
<head>
    <title>Smart Restaurant</title>
    <style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Segoe UI',sans-serif;
}

body{
    min-height:100vh;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    background:linear-gradient(135deg,#5A331C,#8B4513);
    padding:20px;
}

h1{
    color:#E8DEC9;
    font-size:3rem;
    margin-bottom:40px;
    text-align:center;
    text-shadow:2px 2px 8px rgba(0,0,0,0.2);
}

a{
    text-decoration:none;
    width:300px;
    max-width:100%;
}

button{
    width:100%;
    padding:16px;
    border:none;
    border-radius:15px;
    background:#E8DEC9;
    color:#5A331C;
    font-size:18px;
    font-weight:bold;
    cursor:pointer;
    box-shadow:0 6px 15px rgba(0,0,0,0.15);
    transition:all 0.3s ease;
}

button:hover{
    transform:translateY(-4px);
    box-shadow:0 10px 20px rgba(0,0,0,0.2);
    background:#E8DEC9;
}

@media(max-width:768px){

    h1{
        font-size:2.2rem;
    }

    a{
        width:100%;
    }

    button{
        font-size:16px;
        padding:14px;
    }
}
</style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>

<h1>🍽 Smart Restaurant</h1>

<a href="/register">
    <button>User Register</button>
</a>

<br><br>

<a href="/login">
    <button>User Login</button>
</a>

<br><br>

<a href="/admin/login">
    <button>Admin Login</button>
</a>

</body>
</html>