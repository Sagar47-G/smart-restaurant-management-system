<!DOCTYPE html>
<html>
<head>
    <title>Select Table</title>

    <style>

        body{
            font-family:Arial;
            background:#f5f5f5;
            text-align:center;
        }

        h1{
            margin-top:40px;
        }

        .tables{
            display:grid;
            grid-template-columns:repeat(4,150px);
            gap:20px;
            justify-content:center;
            margin-top:40px;
        }

        .table-btn{
            background:#ff6b35;
            color:white;
            text-decoration:none;
            padding:25px;
            border-radius:10px;
            font-size:22px;
            font-weight:bold;
        }

        .table-btn:hover{
            background:#e85a2a;
        }

    </style>
</head>

<body>

<h1>Select Your Table</h1>

<div class="tables">

    <% for(let i=1;i<=8;i++){ %>

        <a
            href="/menu?table=<%= i %>"
            class="table-btn">

            Table <%= i %>

        </a>

    <% } %>

</div>

</body>
</html>