<!DOCTYPE html>
<html>
<head>
    <title>Select Table</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial,sans-serif;
        }

        body{
            min-height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
            background:linear-gradient(135deg,#5A331C,#8B4513);
        }

        .container{
            width:90%;
            max-width:900px;
            text-align:center;
        }

        h1{
            color:white;
            margin-bottom:30px;
            font-size:2rem;
        }

        .tables{
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
            gap:20px;
        }

        .table-btn{
            text-decoration:none;
            background:#E8DEC9;
            color:#5A331C;
            padding:30px;
            border-radius:15px;
            font-size:22px;
            font-weight:bold;
            box-shadow:0 5px 15px rgba(0,0,0,0.2);
            transition:0.3s;
        }

        .table-btn:hover{
            transform:translateY(-5px);
            background:#5A331C;
            color:#E8DEC9;
        }
    </style>

</head>
<body>

<div class="container">

    <h1>🍽 Select Your Table</h1>

    <div class="tables">

        <% for(let i=1; i<=8; i++){ %>

            <a href="/menu?table=<%= i %>" class="table-btn">
                Table <%= i %>
            </a>

        <% } %>

    </div>

</div>

</body>
</html>