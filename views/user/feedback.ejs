<!DOCTYPE html>
<html>
<head>
    <title>Feedback</title>
    <style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Segoe UI',sans-serif;
}

body{
    min-height:100vh;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    background:linear-gradient(135deg,#ff6b35,#ff9f43);
    padding:20px;
}

.feedback-card{
    background:white;
    width:500px;
    max-width:100%;
    padding:35px;
    border-radius:20px;
    box-shadow:0 8px 25px rgba(0,0,0,0.2);
}

h1{
    text-align:center;
    color:#050505;
    margin-bottom:25px;
}

input,
textarea{
    width:100%;
    padding:12px;
    margin-bottom:15px;
    border:2px solid #eee;
    border-radius:10px;
    font-size:16px;
}

input:focus,
textarea:focus{
    outline:none;
    border-color:#ff6b35;
}

textarea{
    min-height:120px;
    resize:vertical;
}

button{
    width:100%;
    padding:14px;
    border:none;
    border-radius:10px;
    background:#ff6b35;
    color:white;
    font-size:18px;
    font-weight:bold;
    cursor:pointer;
    transition:0.3s;
}

button:hover{
    background:#e85a2a;
    transform:translateY(-2px);
}

@media(max-width:768px){

    .feedback-card{
        padding:20px;
    }

    h1{
        font-size:28px;
    }
}
</style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>

<h1>Rate Your Experience</h1>

<form action="/feedback" method="POST">

    <input type="number"
           name="tableNo"
           placeholder="Table Number"
           required>

    <br><br>

    <input type="number"
           name="rating"
           min="1"
           max="5"
           placeholder="Rating (1-5)"
           required>

    <br><br>

    <textarea
        name="comment"
        placeholder="Your feedback">
    </textarea>

    <br><br>

    <button type="submit">
        Submit Feedback
    </button>

</form>

</body>
</html>