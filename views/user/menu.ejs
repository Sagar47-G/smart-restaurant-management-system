<h1>Restaurant Menu</h1>

<h2>Table: <%= tableNo %></h2>

<% menuItems.forEach(item => { %>

<div>
    <h3><%= item.name %></h3>

    <p>₹<%= item.price %></p>

    <a href="/add-to-cart/<%= item.name %>/<%= item.price %>">
        <button>Add to Cart</button>
    </a>
</div>

<hr>

<% }) %>

<a href="/cart">
    <button>View Cart</button>
</a>