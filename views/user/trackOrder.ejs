<!DOCTYPE html>
<html>
<head>
    <title>Track Order</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Segoe UI',sans-serif;
}

body{
    background: #E8DEC9;
    min-height:100vh;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    padding:20px;
}

.track-card{
    background:#E8DEC9;
    width:500px;
    max-width:100%;
    padding:30px;
    border-radius:20px;
    text-align:center;
    box-shadow:0 8px 25px rgba(0,0,0,0.15);
}

h1{
    color:#5A331C;
    margin-bottom:20px;
}

.order-id{
    font-size:18px;
    margin-bottom:20px;
    color:#555;
}

.status{
    margin:20px 0;
    padding:15px;
    border-radius:10px;
    font-size:24px;
    font-weight:bold;
}

.received{
    background:#fff3cd;
    color:#ff9800;
}

.preparing{
    background:#e3f2fd;
    color:#2196f3;
}

.ready{
    background:#e8f5e9;
    color:#28a745;
}

.served{
    background:#f3e5f5;
    color:#9c27b0;
}

button{
    width:100%;
    padding:14px;
    border:none;
    border-radius:10px;
    background:#5A331C;
    color:#E8DEC9;
    font-size:18px;
    font-weight:bold;
    cursor:pointer;
}

button:hover{
    background:#8B4513;
}

a{
    text-decoration:none;
}

@media(max-width:768px){

    .track-card{
        padding:20px;
    }

    .status{
        font-size:20px;
    }
}
</style>
</head>
<body>

<h1>Track Your Order</h1>

<p>Order ID: <%= order._id %></p>

<p>Status: <%= order.status %></p>

<% if(order.status === "Received") { %>
    <h2 style="color:orange;">🟡 Received</h2>
<% } %>

<% if(order.status === "Preparing") { %>
    <h2 style="color:blue;">🟠 Preparing</h2>
<% } %>

<% if(order.status === "Ready") { %>
    <h2 style="color:green;">🟢 Ready</h2>
<% } %>

<% if(order.status === "Served") { %>
    <h2 style="color:purple;">✅ Served</h2>
<% } %>

<a href="/bill/<%= order._id %>">
    <button>View Bill</button>
</a>

</body>
</html>